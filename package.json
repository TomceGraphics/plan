{
  "name": "plan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plan \u2014 a fast, local-first calendar and task planner for Linux",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
